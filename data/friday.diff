Author: Wren team <wren-dev@kestrel.example>
Date:   Fri Sep 25 16:48:03 2026 -0700

    Tell Wren the time; simplify the system prompt

    Wren kept offering phone callbacks at 2am, when the phone line is
    closed. Put the current time at the top of the system prompt.

    Cleanup while here: pass the system prompt as a plain string. The
    top-level cache_control already turns on caching.

diff --git a/wren/requests.py b/wren/requests.py
index 3f1c9e2..8a74d05 100644
--- a/wren/requests.py
+++ b/wren/requests.py
@@ -21,9 +21,7 @@ def make_request(system, messages: list) -> dict:
         "max_tokens": config.MAX_TOKENS,
         # Top-level cache_control turns on automatic caching: the API puts the
         # breakpoint on the last cacheable block of the request.
         "cache_control": {"type": "ephemeral"},
-        "system": [
-            {"type": "text", "text": system, "cache_control": {"type": "ephemeral"}}
-        ],
+        "system": system,
         "messages": messages,
     }
@@ -31,4 +29,5 @@ def make_request(system, messages: list) -> dict:

 def build_request(history: list, question: str, now: str) -> dict:
     """One customer message: the handbook, the conversation so far, the new message."""
-    return make_request(HANDBOOK, history + [{"role": "user", "content": question}])
+    system = f"Current time: {now}\n\n{HANDBOOK}"
+    return make_request(system, history + [{"role": "user", "content": question}])
